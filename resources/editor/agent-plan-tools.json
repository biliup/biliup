{
  "source": "Uncut spec/agent/tools.json, MIT; see licenses/uncut/LICENSE",
  "schemas": {
    "ask_user": {
      "type": "object",
      "required": [
        "question"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "options": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "detail": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "multi": {
          "type": "boolean",
          "description": "Several options may be picked."
        },
        "freeText": {
          "type": "boolean",
          "description": "A box for their own answer (default true; always on without options)."
        }
      }
    },
    "brief_write": {
      "type": "object",
      "required": [
        "film",
        "audience",
        "duration",
        "formats",
        "assets",
        "visual",
        "hardLines",
        "deliverables"
      ],
      "additionalProperties": false,
      "properties": {
        "film": {
          "type": "string",
          "maxLength": 600,
          "description": "The film in one sentence."
        },
        "audience": {
          "type": "string",
          "maxLength": 600
        },
        "duration": {
          "type": "string",
          "maxLength": 60,
          "description": "e.g. \"20 s\""
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "description": "e.g. \"9:16 1080x1920\""
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "The real assets it uses (recordings, screenshots, the kit's logo)."
        },
        "visual": {
          "type": "string",
          "maxLength": 2000,
          "description": "Visual direction."
        },
        "hardLines": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What it must never do."
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "type": {
          "type": "string",
          "enum": [
            "launch-promo",
            "product-demo",
            "tutorial",
            "talk",
            "vlog",
            "social",
            "explainer",
            "music-video",
            "meme",
            "gaming",
            "other"
          ],
          "description": "The kind of video. The critic judges it as that kind (a tutorial needs no hook, a meme may be loud) and the sound limits follow it. Leave it out and Biliup guesses from the brief's words."
        },
        "skills": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "description": "Skills (names from the system prompt's Skills list) that fit this video. Leave it out and Biliup suggests a set from the type and the brief. Read the ones that fit with skill_read."
        }
      }
    },
    "storyboard_propose": {
      "type": "object",
      "required": [
        "summary",
        "beats"
      ],
      "additionalProperties": false,
      "properties": {
        "approve": {
          "type": "string",
          "enum": [
            "self"
          ],
          "description": "Only when the user said nobody can answer (\"decide yourself\"): approve it yourself instead of waiting; the card says so. The critic loop still runs."
        },
        "summary": {
          "type": "string",
          "maxLength": 600
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "required": [
              "start",
              "end",
              "title",
              "entry",
              "exit",
              "purpose"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0,
                "description": "Seconds from the start of the video."
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "maxLength": 120
              },
              "entry": {
                "type": "string",
                "maxLength": 600,
                "description": "What's on screen as the beat starts."
              },
              "exit": {
                "type": "string",
                "maxLength": 600,
                "description": "What's on screen as it ends (the next beat's entry)."
              },
              "purpose": {
                "type": "string",
                "maxLength": 400,
                "description": "Why the beat is there: what the viewer gets from it."
              },
              "assets": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "maxLength": 200
                },
                "description": "The real assets it shows (media names, kit logo, recordings)."
              },
              "sound": {
                "type": "string",
                "maxLength": 200,
                "description": "The beat, downbeat or hit it lands on."
              },
              "still": {
                "description": "A timeline frame (an integer from 0), or {\"graphic\": \"film.html\", \"t\": 12.5} (seconds) drawn alone without placing it.",
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "graphic"
                    ],
                    "properties": {
                      "graphic": {
                        "type": "string"
                      },
                      "t": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "plan_read": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  }
}
