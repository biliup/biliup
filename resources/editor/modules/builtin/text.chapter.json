{
  "manifest": "biliup.module/1",
  "id": "text.chapter",
  "kind": "text-style",
  "name": "Chapter number",
  "description": "A big number for a chapter or a step.",
  "version": "0.1.0",
  "author": "Biliup",
  "license": "MIT",
  "builtin": true,
  "runtime": {
    "type": "html"
  },
  "ui": {
    "panel": "text"
  },
  "look": {
    "size": 0.24,
    "weight": 800,
    "font": "DM Sans",
    "tracking": -0.05,
    "lineHeight": 0.9,
    "color": "accent",
    "x": 0.08,
    "y": 0.28,
    "text": "01",
    "animation": {
      "in": {
        "module": "move.zoom",
        "seconds": 0.5,
        "params": {
          "scale": 1.3,
          "ease": "out",
          "fade": true
        }
      }
    }
  }
}
