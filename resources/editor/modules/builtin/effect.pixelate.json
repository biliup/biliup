{
  "manifest": "biliup.module/1",
  "id": "effect.pixelate",
  "kind": "effect",
  "name": "Pixelate",
  "description": "Big square pixels",
  "version": "0.1.0",
  "author": "Biliup",
  "license": "MIT",
  "builtin": true,
  "runtime": {
    "type": "native"
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "size": {
        "type": "number",
        "minimum": 2,
        "maximum": 80,
        "default": 16,
        "description": "Size (canvas px)"
      }
    }
  },
  "ui": {
    "panel": "effects",
    "icon": "grid-3x3"
  }
}
