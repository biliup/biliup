{
  "manifest": "biliup.module/1",
  "id": "effect.look",
  "kind": "effect",
  "name": "Filter",
  "description": "A colour look on a clip: a built-in look or a custom definition, at intensity 0-1",
  "version": "0.1.0",
  "author": "Biliup",
  "license": "MIT",
  "builtin": true,
  "runtime": {
    "type": "native"
  },
  "params": {
    "type": "object",
    "required": [
      "look"
    ],
    "additionalProperties": false,
    "properties": {
      "look": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "description": "The look: natural, warm, cool, vintage, film, teal-orange, bw, noir, fade, vivid, moody, sepia, cinematic, pastel, golden, arctic; a custom look carries its definition in custom."
      },
      "intensity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 1
      },
      "custom": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mixer": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "items": {
              "type": "number",
              "minimum": -4,
              "maximum": 4
            },
            "description": "Channel mixer rows: r, g, b from r, g, b."
          },
          "mono": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "adjust": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exposure": {
                "type": "number",
                "minimum": -2,
                "maximum": 2,
                "default": 0,
                "description": "Exposure in stops"
              },
              "contrast": {
                "type": "number",
                "minimum": -1,
                "maximum": 1,
                "default": 0,
                "description": "Contrast, -1 to 1 (0 = unchanged)"
              },
              "saturation": {
                "type": "number",
                "minimum": -1,
                "maximum": 1,
                "default": 0,
                "description": "Saturation, -1 to 1 (0 = unchanged)"
              },
              "temperature": {
                "type": "number",
                "minimum": -1,
                "maximum": 1,
                "default": 0,
                "description": "Temperature, -1 to 1 (0 = unchanged)"
              },
              "tint": {
                "type": "number",
                "minimum": -1,
                "maximum": 1,
                "default": 0,
                "description": "Tint, -1 to 1 (0 = unchanged)"
              },
              "highlights": {
                "type": "number",
                "minimum": -1,
                "maximum": 1,
                "default": 0,
                "description": "Highlights, -1 to 1 (0 = unchanged)"
              },
              "shadows": {
                "type": "number",
                "minimum": -1,
                "maximum": 1,
                "default": 0,
                "description": "Shadows, -1 to 1 (0 = unchanged)"
              },
              "vibrance": {
                "type": "number",
                "minimum": -1,
                "maximum": 1,
                "default": 0,
                "description": "Vibrance, -1 to 1 (0 = unchanged)"
              }
            }
          },
          "curve": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "red": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "green": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "blue": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "shadowTint": {
            "type": "object",
            "required": [
              "color",
              "amount"
            ],
            "additionalProperties": false,
            "properties": {
              "color": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "highlightTint": {
            "type": "object",
            "required": [
              "color",
              "amount"
            ],
            "additionalProperties": false,
            "properties": {
              "color": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "fade": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          }
        },
        "description": "The custom colour definition stored with the clip, shared by preview and export."
      },
      "label": {
        "type": "string",
        "maxLength": 60,
        "description": "A custom look's name."
      }
    },
    "if": {
      "not": {
        "required": [
          "custom"
        ]
      }
    },
    "then": {
      "properties": {
        "look": {
          "enum": [
            "natural",
            "warm",
            "cool",
            "vintage",
            "film",
            "teal-orange",
            "bw",
            "noir",
            "fade",
            "vivid",
            "moody",
            "sepia",
            "cinematic",
            "pastel",
            "golden",
            "arctic"
          ]
        }
      }
    }
  },
  "ui": {
    "panel": "effects",
    "icon": "palette"
  }
}
