# sqlx 对迁移文件的原始字节求 SHA-384 并记进 _sqlx_migrations。同一份 SQL 在
# core.autocrlf=true 的 Windows（含 GitHub windows-latest 上的发布构建）会被检出成 CRLF，
# 编出来的二进制就内嵌另一套摘要。一律检出成 LF，各平台的构建才记同一套校验和。
*.sql text eol=lf

# Golden and fixed reference assets retain their source bytes on Windows.
/crates/danmaku-factory/tests/golden/** -text
/crates/danmaku-factory/tests/fixtures/*.ass -text

# 大体积字体资产走 Git LFS：18 MB 的二进制字体内嵌进 biliup 二进制，
# 放进普通 blob 会让每次 clone/fetch 都拖上它们。检出后需要 git-lfs（CI 用 actions/checkout 的 lfs: true）。
/crates/biliup-cli/src/assets/*.otf filter=lfs diff=lfs merge=lfs -text
/crates/biliup-cli/src/assets/*.ttf filter=lfs diff=lfs merge=lfs -text
