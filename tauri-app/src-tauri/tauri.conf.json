{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "biliup",
  "version": "1.3.4",
  "identifier": "com.biliup.desktop",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../crates/biliup-cli/assets/render-tools/": "render-tools/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
