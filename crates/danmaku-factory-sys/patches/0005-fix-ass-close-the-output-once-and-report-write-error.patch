From: Mostly_Harmless <geek520170@gmail.com>
Date: Sat, 10 Oct 2026 16:30:21 +0800
Subject: [PATCH 5/7] fix(ass): close the output once and report write errors

writeAssDanmakuPart() closed the FILE on its out-of-memory and ferror()
paths, and writeAss() then wrote to it and closed it again. Writing to
a full disk (e.g. -o full.ass with full.ass -> /dev/full and enough
danmaku to fill the stdio buffer) aborts with "attempting double-free"
in fclose under AddressSanitizer. The ferror() path also returned
without freeing the occupancy arrays. The stream now belongs to
writeAss() only and every error path goes through BYE.

Data that is still buffered is written by fflush()/fclose(), whose
results were ignored: a small subtitle on a full disk was left empty
or truncated while writeAss() returned 0. writeAss() now adds 200 to its
status when flushing or closing fails.
---
 src/AssFile/AssFile.c | 27 ++++++++++++++++-----------
 1 file changed, 16 insertions(+), 11 deletions(-)

diff --git a/src/AssFile/AssFile.c b/src/AssFile/AssFile.c
index 51c6459..dc2c7c5 100644
--- a/src/AssFile/AssFile.c
+++ b/src/AssFile/AssFile.c
@@ -1106,7 +1106,7 @@ static void mergeGiftDanmaku(DANMAKU *head)
  * 返回值：状态码
  * 个位 函数writeAssStatPart的返回值
  * 十位 函数writeAssDanmakuPart的返回值
- * 百位 1 弹幕池为空
+ * 百位 1 创建文件失败 / 2 写入或关闭文件失败（如磁盘已满）
  */
 int writeAss(const char *const fileName, DANMAKU *danmakuHead, const CONFIG config, const ASSFILE *const subPart,
              STATUS *const status)
@@ -1235,7 +1235,16 @@ int writeAss(const char *const fileName, DANMAKU *danmakuHead, const CONFIG conf
 
     // TODO:添加函数writeAssSubPart()
 
-    fclose(fptr);
+    /* 缓冲区里的数据要到 fflush/fclose 时才真正写出，写失败（如磁盘已满）也只在此时出现 */
+    BOOL writeFailed = fflush(fptr) != 0 || ferror(fptr);
+    if (fclose(fptr) != 0)
+    {
+        writeFailed = TRUE;
+    }
+    if (writeFailed)
+    {
+        returnValue += 200;
+    }
 
     return returnValue;
 }
@@ -1933,32 +1942,29 @@ int writeAssDanmakuPart(FILE *opF, DANMAKU *head, CONFIG config, STATUS *const s
         holdResY = 1;
     }
 
+    /* 出错时不在这里关闭 opF：它由调用方 writeAss 负责关闭，此处关闭会导致二次 fclose */
     if ((R2LToRightTime = (int *)malloc(rollResY * sizeof(int))) == NULL)
     {
-        fclose(opF);
-        return 3;
+        ret_code = 3;
+        goto BYE;
     }
     if ((R2LToLeftTime = (int *)malloc(rollResY * sizeof(int))) == NULL)
     {
-        fclose(opF);
         ret_code = 4;
         goto BYE;
     }
     if ((L2RToRightTime = (int *)malloc(rollResY * sizeof(int))) == NULL)
     {
-        fclose(opF);
         ret_code = 5;
         goto BYE;
     }
     if ((L2RToLeftTime = (int *)malloc(rollResY * sizeof(int))) == NULL)
     {
-        fclose(opF);
         ret_code = 6;
         goto BYE;
     }
     if ((fixEndTime = (int *)malloc(holdResY * sizeof(int))) == NULL)
     {
-        fclose(opF);
         ret_code = 7;
         goto BYE;
     }
@@ -2513,7 +2519,6 @@ int writeAssDanmakuPart(FILE *opF, DANMAKU *head, CONFIG config, STATUS *const s
             if ((newMsgNode = (MSGLIST *)malloc(sizeof(MSGLIST))) == NULL)
             {
                 /* TODO: 异常处理 */
-                fclose(opF);
                 ret_code = 3;
                 goto BYE;
             }
@@ -2579,8 +2584,8 @@ int writeAssDanmakuPart(FILE *opF, DANMAKU *head, CONFIG config, STATUS *const s
 
         if (ferror(opF))
         {
-            fclose(opF);
-            return 9;
+            ret_code = 9;
+            goto BYE;
         }
 
     NEXTNODE:
